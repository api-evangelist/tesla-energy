                        ":site_id",
                        "time_of_use_settings"
                      ],
                      "variable": [
                        {
                          "id": "97100bf3-16f0-4803-9e26-b672910dcbde",
                          "key": "site_id",
                          "value": "<string>",
                          "description": "(Required) The energy_site_id returned by /products."
                        }
                      ]
                    },
                    "description": "Updates the time-of-use tariff schedule for the site, including peak/off-peak windows, seasonal rates, and self-consumption optimization toggles."
                  },
