                        "key": "Content-Type",
                        "value": "application/json"
                      },
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "{\n  \"tou_settings\": {\n    \"optimization_strategy\": \"economics\",\n    \"schedule\": [\n      {\n        \"target\": \"partial_peak\",\n        \"week_days\": [\n          \"<integer>\",\n          \"<integer>\"\n        ],\n        \"start_seconds\": \"<integer>\",\n        \"end_seconds\": \"<integer>\"\n      },\n      {\n        \"target\": \"partial_peak\",\n        \"week_days\": [\n          \"<integer>\",\n          \"<integer>\"\n        ],\n        \"start_seconds\": \"<integer>\",\n        \"end_seconds\": \"<integer>\"\n      }\n    ]\n  }\n}",
                      "options": {
                        "raw": {
                          "headerFamily": "json",
                          "language": "json"
                        }
                      }
                    },
                    "url": {
                      "raw": "{{baseUrl}}/energy_sites/:site_id/time_of_use_settings",
                      "host": [
