{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tesla Fleet Energy Backup API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://auth.tesla.com/oauth2/v3/authorize",
      "accessTokenUrl": "https://auth.tesla.com/oauth2/v3/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Backup",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Tesla Set Backup Reserve Percent",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://fleet-api.prd.na.vn.cloud.tesla.com/api/1/energy_sites/:site_id/backup",
            "params": [
              {
                "name": "site_id",
                "value": "",
                "type": "path",
                "description": "The energy_site_id returned by /products."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Sets the percent state-of-charge that Powerwall holds in reserve for grid outages. Range 0-100. Requires the energy_cmds scope."
        }
      ]
    }
  ],
  "bundled": true
}