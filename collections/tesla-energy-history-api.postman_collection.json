          "name": "Tesla Get Energy Site Calendar History",
          "request": {
            "name": "Tesla Get Energy Site Calendar History",
            "description": {
              "content": "Returns time-series energy data — production, consumption, grid import/export, battery charge/discharge — aggregated by day, week, month, or year. Supports kind=energy, power, self_consumption, savings, and time_of_use.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "energy_sites",
                ":site_id",
                "calendar_history"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "kind",
                  "value": "<string>",
                  "description": "(Required) Type of history to retrieve."
                },
                {
                  "disabled": false,
                  "key": "period",
                  "value": "<string>",
                  "description": "Aggregation period."
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<dateTime>",
                  "description": "ISO-8601 end of the window."
                },
                {
                  "disabled": false,
                  "key": "time_zone",
                  "value": "<string>"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "site_id",
                  "description": "(Required) The energy_site_id returned by /products."
                }
              ]
            },
